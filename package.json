{
  "name": "tellus",
  "version": "1.0.0",
  "description": "Tellus — Local AI hub with multi-provider support (OpenRouter, Google, Anthropic, OpenAI), continuous memory engine and agentic tools.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd server && npm run build && cd ../client && npm run build",
    "test": "cd server && npm test",
    "desktop": "electron .",
    "dist": "npm run build && electron-builder --win nsis portable",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:installer": "npm run build && electron-builder --win nsis",
    "generate-icons": "node scripts/generate-icons.js",
    "create-shortcut": "powershell -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1"
  },
  "build": {
    "appId": "com.tellus.app",
    "productName": "Tellus",
    "asar": false,
    "directories": {
      "output": "dist-app"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tellus",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "files": [
      "electron/**/*",
      "server/dist/**/*",
      "server/package.json",
      "server/node_modules/**/*",
      "client/dist/**/*",
      "resources/**/*",
      "skills/**/*"
    ]
  },
  "keywords": [
    "tellus",
    "agentic",
    "ai",
    "openrouter",
    "ai-memory",
    "claude",
    "gemini",
    "openai"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "diff": "^7.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.10"
  }
}
