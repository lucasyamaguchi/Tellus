# ============================================================
#  Tellus — .gitignore
# ============================================================

# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Build outputs
client/dist/
server/dist/
dist-app/

# Environment & API keys — NEVER commit these
.env
.env.*
*.env
.env.local
.env.development
.env.production

# Tellus user config (contains API keys)
# This folder lives at ~/.tellus/ on the user's machine
# and should NEVER be inside the project dir either
config.json

# Project memory & sessions (user-specific data)
.agentic/
**/.agentic/

# Uploaded attachments & screenshots
attachments/
**/attachments/

# Windows OS files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Windows shortcut files (machine-specific paths)
*.lnk

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime / temp
*.pid
*.seed
*.pid.lock
.tmp/
tmp/

# Editor & IDE files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# TypeScript incremental compilation
*.tsbuildinfo

# Coverage
coverage/
.nyc_output/

# Optional caches
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# Lock files (keep package-lock.json, ignore yarn/pnpm)
yarn.lock
pnpm-lock.yaml

# Generated icon files (regenerated via npm run generate-icons)
# Keep icon.ico and icon.png in resources/ since they're part of the build
# But don't track the source Gemini generated image if it's large
# Gemini_Generated_Image_*.png

# Electron build artifacts
dist/
out/

# Test artifacts
test-results/
playwright-report/

# Documentation artifacts (generated by AI — keep DOCUMENTACAO.md in repo)
# None excluded here

# GitSafe Privacy Shields
*.sqlite
*.sqlite3
*.db
*.key
*.pem
*.cert
*.p12
*.pfx
